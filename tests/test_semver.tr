from src.semver import Version

def assert_eq(got: str, want: str, label: str):
    if got != want:
        print("FAIL " + label + ": got=" + got + " want=" + want)
    else:
        print("ok   " + label)

def assert_bool(got: bool, want: bool, label: str):
    mut gs = "true" if got else "false"
    mut ws = "true" if want else "false"
    if got != want:
        print("FAIL " + label + ": got=" + gs + " want=" + ws)
    else:
        print("ok   " + label)

def main() -> int:
    # Parse
    mut v = Version.init("1.2.3")
    assert_eq(str(v.major), "1", "parse major")
    assert_eq(str(v.minor), "2", "parse minor")
    assert_eq(str(v.patch), "3", "parse patch")

    mut vv = Version.init("v0.10.0")
    assert_eq(str(vv.major), "0", "parse v-prefix major")
    assert_eq(str(vv.minor), "10", "parse v-prefix minor")

    # to_string
    assert_eq(v.to_string(), "1.2.3", "to_string")

    # compare
    mut a = Version.init("1.0.0")
    mut b = Version.init("2.0.0")
    mut c = Version.init("1.0.0")
    assert_bool(a.lt(b), true,  "lt true")
    assert_bool(b.lt(a), false, "lt false")
    assert_bool(a.eq(c), true,  "eq true")
    assert_bool(a.eq(b), false, "eq false")
    assert_bool(b.gt(a), true,  "gt true")

    # satisfies — wildcard
    assert_bool(Version.init("1.2.3").satisfies("*"), true, "wildcard *")
    assert_bool(Version.init("1.2.3").satisfies(""),  true, "wildcard empty")

    # satisfies — exact
    assert_bool(Version.init("1.2.3").satisfies("1.2.3"), true,  "exact match")
    assert_bool(Version.init("1.2.4").satisfies("1.2.3"), false, "exact no-match")

    # satisfies — ^
    assert_bool(Version.init("1.5.0").satisfies("^1.2.0"), true,  "caret same-major hi-minor")
    assert_bool(Version.init("2.0.0").satisfies("^1.2.0"), false, "caret next-major")
    assert_bool(Version.init("1.1.9").satisfies("^1.2.0"), false, "caret below-base")

    # satisfies — ~
    assert_bool(Version.init("1.2.9").satisfies("~1.2.0"), true,  "tilde same-minor patch bump")
    assert_bool(Version.init("1.3.0").satisfies("~1.2.0"), false, "tilde next-minor")
    assert_bool(Version.init("1.2.0").satisfies("~1.2.0"), true,  "tilde exact base")

    # satisfies — >=
    assert_bool(Version.init("1.3.0").satisfies(">=1.2.0"), true,  "gte above")
    assert_bool(Version.init("1.2.0").satisfies(">=1.2.0"), true,  "gte equal")
    assert_bool(Version.init("1.1.9").satisfies(">=1.2.0"), false, "gte below")

    # satisfies — >
    assert_bool(Version.init("1.3.0").satisfies(">1.2.0"), true,  "gt above")
    assert_bool(Version.init("1.2.0").satisfies(">1.2.0"), false, "gt equal (exclusive)")

    # satisfies — <=
    assert_bool(Version.init("1.2.0").satisfies("<=1.2.0"), true,  "lte equal")
    assert_bool(Version.init("1.3.0").satisfies("<=1.2.0"), false, "lte above")

    # satisfies — <
    assert_bool(Version.init("1.1.9").satisfies("<1.2.0"), true,  "lt below")
    assert_bool(Version.init("1.2.0").satisfies("<1.2.0"), false, "lt equal (exclusive)")

    # best_match
    mut versions = Vec[str].init(4)
    versions.push("1.0.0")
    versions.push("1.1.0")
    versions.push("1.2.0")
    versions.push("2.0.0")
    assert_eq(Version.best_match(versions, "^1.0.0"), "1.2.0", "best_match caret")
    assert_eq(Version.best_match(versions, "~1.1.0"), "1.1.0", "best_match tilde")
    assert_eq(Version.best_match(versions, ">=2.0.0"), "2.0.0", "best_match gte exact")
    assert_eq(Version.best_match(versions, ">2.0.0"),  "",      "best_match none satisfies")

    print("semver tests done")
    return 0
