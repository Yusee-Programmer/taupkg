# taupkg -- Tauraro package manager
# Entry point: command dispatch.

from std.io import File
from std.os import OS, Process, Env
from cli import parse_args, print_usage, CliArgs
from manifest import Manifest
from lockfile import Lockfile, LockedPkg
from semver import Version
from source import parse_source
from installer import install_package
from resolver import resolve, Resolution, ResolvedDep
from builder import build_project, run_binary, find_compiler, tauraro_path_value, apply_tauraro_path
from registry import registry_search
from util import path_join, mkdir_p, shell_capture, project_pkg_dir, project_build_dir, rm_rf, credentials_path, taupkg_home, hash_tree
from tauraro_install import install_tauraro
from bindgen_cmd import cmd_bindgen

def main(argv: Vec[str]):
    mut args = parse_args(argv)
    mut verbose = args.flag("verbose") or args.flag("v")

    # `bindgen` is dispatched first: it parses its own raw argv (so `-h cpp` for
    # C++ mode is not mistaken for `-h` help) and needs no project taupkg.toml.
    if args.command == "bindgen":
        return cmd_bindgen(argv, OS.cwd(), verbose)

    if args.command == "" or args.command == "help" or args.flag("help") or args.flag("h"):
        print_usage()
        return 0

    if args.command == "version":
        print("taupkg 0.0.2")
        return 0

    if args.command == "install-tauraro":
        mut ver     = args.flag_val("version", "")
        mut mirror  = args.flag("mirror")
        return install_tauraro(ver, mirror, verbose)

    if args.command == "init":
        return cmd_init(args)

    if args.command == "search":
        return cmd_search(args)

    # All remaining commands need a project root with taupkg.toml
    mut cwd = OS.cwd()
    mut project_root = find_project_root(cwd)
    mut manifest_path = path_join(project_root, "taupkg.toml")
    if not File.file_exists(manifest_path):
        print("error: no taupkg.toml found. Run `taupkg init` first.")
        return 1

    mut manifest = Manifest.load(manifest_path)
    if not manifest.is_valid():
        print("error: invalid taupkg.toml -- 'name' and 'version' are required")
        return 1

    mut lock_path = path_join(project_root, "taupkg.lock")
    mut lockfile  = Lockfile.load(lock_path)

    if args.command == "login":
        return cmd_login(args)

    if args.command == "install":
        return cmd_install(args, manifest, lockfile, lock_path, project_root, verbose)

    if args.command == "tree":
        return cmd_tree(manifest, lockfile, project_root, verbose)

    if args.command == "audit":
        return cmd_audit(manifest, lockfile, project_root, verbose)

    if args.command == "add":
        return cmd_add(args, manifest, manifest_path, lockfile, lock_path, project_root, verbose)

    if args.command == "remove":
        return cmd_remove(args, manifest, manifest_path, lockfile, lock_path, project_root)

    if args.command == "update":
        return cmd_update(args, manifest, lockfile, lock_path, project_root, verbose)

    if args.command == "build":
        return cmd_build(args, manifest, lockfile, project_root, verbose)

    if args.command == "run":
        mut rc = cmd_build(args, manifest, lockfile, project_root, verbose)
        if rc != 0:
            return rc
        return run_binary(project_root, manifest, args.passthrough)

    if args.command == "env":
        return cmd_env(manifest, lockfile, project_root)

    if args.command == "test":
        return cmd_test(manifest, lockfile, project_root, verbose)

    if args.command == "list":
        return cmd_list(lockfile)

    if args.command == "info":
        return cmd_info(args, lockfile)

    if args.command == "clean":
        rm_rf(project_build_dir(project_root))
        print("Cleaned .taupkg/build/")
        return 0

    if args.command == "publish":
        return cmd_publish(manifest, manifest_path, project_root, verbose)

    print("error: unknown command '" + args.command + "'. Run `taupkg help` for usage.")


# -- init ----------------------------------------------------------------------

def cmd_init(args: CliArgs) -> int:
    mut cwd = OS.cwd()
    mut toml_path = path_join(cwd, "taupkg.toml")
    if File.file_exists(toml_path):
        print("taupkg.toml already exists.")
        return 1

    mut name = args.first_pos()
    if name.len() == 0:
        # Derive from directory name
        mut parts = cwd.split("/")
        if parts.len == 0:
            parts = cwd.split("\\")
        if parts.len > 0:
            name = parts.get(parts.len - 1)
        else:
            name = "myproject"
    name = name.to_lower()

    mut content = "[package]\n"
    content = content + "name    = \"" + name + "\"\n"
    content = content + "version = \"0.1.0\"\n"
    content = content + "desc    = \"\"\n"
    content = content + "license = \"MIT\"\n"
    content = content + "bin     = \"src/main.tr\"\n\n"
    content = content + "[deps]\n"

    File.write_text(toml_path, content)
    mkdir_p(path_join(cwd, "src"))

    mut main_path = path_join(cwd, "src/main.tr")
    if not File.file_exists(main_path):
        File.write_text(main_path, "def main() -> int:\n    print(\"Hello from " + name + "!\")\n    return 0\n")

    print("Created taupkg.toml and src/main.tr")
    return 0


# -- install --------------------------------------------------------------------

def cmd_install(args: CliArgs, manifest: Manifest, lockfile: Lockfile, lock_path: str, project_root: str, verbose: bool) -> int:
    mut locked  = args.flag("locked") or args.flag("frozen")
    mut offline = args.flag("offline")

    # In --locked mode we replay the existing lock exactly (CI-reproducible). Otherwise we resolve the
    # FULL transitive graph fresh and (re)write the lock. Dev-deps are resolved for the top-level project
    # so `test`/examples work; they are NOT propagated to consumers.
    mut res = resolve(manifest, project_root, lockfile, true, locked, offline, verbose)
    if not res.ok:
        print("error: " + res.error)
        return 1

    if res.order.len == 0:
        print("No dependencies to install.")
        return 0

    # Report the resolved graph.
    mut i = 0
    while i < res.order.len:
        mut nm = res.order.get(i)
        i = i + 1
        if res.by_name.contains(nm):
            mut d = res.by_name.get(nm)
            print("  + " + d.name + "@" + d.version)

    # In --locked mode the lock is authoritative; otherwise persist the freshly-resolved graph.
    if not locked:
        mut new_lock = res.to_lockfile()
        new_lock.save(lock_path)

    print("Resolved " + str(res.order.len) + " package(s) (direct + transitive).")
    return 0


# -- add ------------------------------------------------------------------------

def cmd_add(args: CliArgs, manifest: Manifest, manifest_path: str, lockfile: Lockfile, lock_path: str, project_root: str, verbose: bool) -> int:
    mut spec = args.first_pos()
    if spec.len() == 0:
        print("Usage: taupkg add <package>[@constraint]")
        return 1

    # Split name@constraint
    mut dep_name   = spec
    mut constraint = "*"
    mut at_pos = spec.index_of("@")
    if at_pos >= 0:
        dep_name   = spec.slice(0, at_pos)
        constraint = spec.slice(at_pos + 1, spec.len())

    mut source_uri = constraint
    if args.pos_args.len > 1:
        source_uri = args.pos_args.get(1)  # explicit source URI

    print("Adding " + dep_name + " " + constraint + "...")
    mut pkg = install_package(dep_name, constraint, source_uri, project_root, verbose)
    if pkg.name.len() == 0:
        return 1

    # Update taupkg.toml [deps]
    mut content = File.read_text(manifest_path)
    mut dep_line = dep_name + " = \"" + constraint + "\"\n"
    if content.contains("[deps]"):
        content = content + dep_line
    else:
        content = content + "\n[deps]\n" + dep_line
    File.write_text(manifest_path, content)

    lockfile.upsert(pkg)
    lockfile.save(lock_path)
    print("  + " + dep_name + "@" + pkg.version)
    return 0


# -- remove ---------------------------------------------------------------------

def cmd_remove(args: CliArgs, manifest: Manifest, manifest_path: str, lockfile: Lockfile, lock_path: str, project_root: str) -> int:
    mut dep_name = args.first_pos()
    if dep_name.len() == 0:
        print("Usage: taupkg remove <package>")
        return 1

    # Remove from taupkg.toml by rewriting without that line
    mut content = File.read_text(manifest_path)
    mut lines = content.split("\n")
    mut out = ""
    mut i = 0
    while i < lines.len:
        mut line = lines.get(i)
        mut trimmed = line.trim()
        # Skip any line that starts with the dep name followed by ' =' or '='
        if not (trimmed.starts_with(dep_name) and trimmed.contains("=")):
            out = out + line + "\n"
        i = i + 1
    File.write_text(manifest_path, out)

    # Remove from .taupkg/packages/
    mut pkg_dir = path_join(project_pkg_dir(project_root), dep_name)
    if File.dir_exists(pkg_dir):
        rm_rf(pkg_dir)

    # Remove from lockfile (rebuild without it)
    mut new_lf = Lockfile.init()
    mut j = 0
    while j < lockfile.packages.len:
        mut p = lockfile.packages.get(j)
        if p.name != dep_name:
            new_lf.packages.push(p)
        j = j + 1
    new_lf.save(lock_path)

    print("Removed " + dep_name)
    return 0


# -- update ---------------------------------------------------------------------

def cmd_update(args: CliArgs, manifest: Manifest, lockfile: Lockfile, lock_path: str, project_root: str, verbose: bool) -> int:
    # `update` IGNORES the lock (locked=false) and re-resolves the whole graph to the newest compatible
    # versions, then rewrites the lock. (A `<pkg>` argument updating only one package while keeping the
    # rest pinned is a planned refinement — for now `update` refreshes the entire graph.)
    mut res = resolve(manifest, project_root, lockfile, true, false, false, verbose)
    if not res.ok:
        print("error: " + res.error)
        return 1
    mut i = 0
    while i < res.order.len:
        mut nm = res.order.get(i)
        i = i + 1
        if res.by_name.contains(nm):
            mut d = res.by_name.get(nm)
            print("  -> " + d.name + "@" + d.version)
    res.to_lockfile().save(lock_path)
    print("Updated to newest compatible versions.")
    return 0


# -- build ----------------------------------------------------------------------

def cmd_build(args: CliArgs, manifest: Manifest, lockfile: Lockfile, project_root: str, verbose: bool) -> int:
    mut release = args.flag("release")
    mut output  = args.flag_val("o", "")
    mut target  = args.flag_val("target", "")   # zero-config cross-compile (tauraroc bundles zig cc)
    mut sandbox = args.flag("sandbox")          # hermetic fallback: copy into .taupkg/build/

    # Make sure the full transitive graph is present before compiling. If a lock exists, replay it
    # (installing anything missing, verifying checksums); otherwise resolve fresh.
    mut has_lock = lockfile.packages.len > 0
    mut res = resolve(manifest, project_root, lockfile, false, has_lock, false, verbose)
    if not res.ok:
        print("error: " + res.error)
        return 1
    mut eff_lock = res.to_lockfile()
    if not has_lock and eff_lock.packages.len > 0:
        eff_lock.save(path_join(project_root, "taupkg.lock"))

    mut ok = build_project(project_root, manifest, eff_lock, output, release, target, sandbox, verbose)
    if ok:
        print("Build succeeded.")
        return 0
    return 1


# -- env ------------------------------------------------------------------------
# Print the TAURARO_PATH line for compiling this project with `tauraroc` directly
# (taupkg build sets it automatically; this is the manual escape hatch). Shell-
# appropriate so it can be eval'd: `eval "$(taupkg env)"` on POSIX.
def cmd_env(manifest: Manifest, lockfile: Lockfile, project_root: str) -> int:
    mut val = tauraro_path_value(project_root, lockfile)
    if val.len() == 0:
        print("# taupkg: no dependencies installed — TAURARO_PATH is not needed here.")
        return 0
    if OS.is_windows():
        print("set TAURARO_PATH=" + val)
        print("# PowerShell:  $env:TAURARO_PATH = \"" + val + "\"")
    else:
        print("export TAURARO_PATH=\"" + val + "\"")
    return 0


# -- test -----------------------------------------------------------------------

def cmd_test(manifest: Manifest, lockfile: Lockfile, project_root: str, verbose: bool) -> int:
    mut cc = find_compiler()
    mut test_dir = path_join(project_root, "tests")
    if not File.dir_exists(test_dir):
        print("No tests/ directory found.")
        return 0

    # Tests import the project's deps too — set TAURARO_PATH automatically.
    apply_tauraro_path(project_root, lockfile, verbose)

    # Find test files: tests/test_*.tr
    mut rc = Process.system("ls \"" + test_dir + "\"")  # for now just check dir is non-empty
    # TODO: When tau gets a built-in test runner, delegate here.
    # For now, compile and run each test_*.tr file.
    print("Running tests in " + test_dir + "...")
    mut cmd = cc + " " + test_dir + "/test_*.tr -o .taupkg/test_runner"
    if OS.is_windows():
        cmd = cc + " \"" + test_dir + "\\test_all.tr\" -o \".taupkg\\test_runner.exe\""
    mut result = Process.system(cmd)
    if result != 0:
        return result
    if OS.is_windows():
        return Process.system(".taupkg\\test_runner.exe")
    return Process.system(".taupkg/test_runner")


# -- list -----------------------------------------------------------------------

def cmd_list(lockfile: Lockfile) -> int:
    if lockfile.packages.len == 0:
        print("No packages installed.")
        return 0
    print("Installed packages:")
    mut i = 0
    while i < lockfile.packages.len:
        mut p = lockfile.packages.get(i)
        print("  " + p.name + " " + p.version)
        i = i + 1
    return 0


# -- info -----------------------------------------------------------------------

def cmd_info(args: CliArgs, lockfile: Lockfile) -> int:
    mut pkg_name = args.first_pos()
    if pkg_name.len() == 0:
        print("Usage: taupkg info <package>")
        return 1
    if lockfile.has(pkg_name):
        mut p = lockfile.find(pkg_name)
        print("Name:     " + p.name)
        print("Version:  " + p.version)
        print("Source:   " + p.source)
        print("Checksum: " + p.checksum)
        return 0
    print("Package '" + pkg_name + "' is not installed. Use `taupkg search` to find it.")
    return 1


# -- search ---------------------------------------------------------------------

def cmd_search(args: CliArgs) -> int:
    mut query = args.first_pos()
    if query.len() == 0:
        print("Usage: taupkg search <query>")
        return 1
    registry_search(query)
    return 0


# -- publish --------------------------------------------------------------------

def cmd_publish(manifest: Manifest, manifest_path: str, project_root: str, verbose: bool) -> int:
    from registry import registry_publish
    # Create a tarball of the project src/
    mut tarball = path_join(project_root, ".taupkg/" + manifest.name + "-" + manifest.version + ".tar.gz")
    mkdir_p(path_join(project_root, ".taupkg"))
    mut src_dir = path_join(project_root, "src")
    # `tar` ships with Windows 10+ (bsdtar) and every Unix, so one command works everywhere.
    mut cmd = "tar -czf \"" + tarball + "\" -C \"" + project_root + "\" src taupkg.toml"
    mut rc = Process.system(cmd)
    if rc != 0:
        print("error: failed to create tarball")
        return 1
    mut ok = registry_publish(manifest_path, tarball)
    if ok:
        print("Published " + manifest.name + " " + manifest.version)
        return 0
    return 1


# -- internal helpers -----------------------------------------------------------


# Finds the project root directory
pub def find_project_root(start_dir: str) -> str:
    mut dir = start_dir
    mut limit = 16
    while limit > 0:
        mut candidate = dir + "/taupkg.toml"
        if File.file_exists(candidate):
            return dir
        mut pos = dir.len() - 1
        while pos > 0:
            mut c = dir.char_at(pos)
            if c == 47 or c == 92:
                break
            pos = pos - 1
        if pos <= 0:
            return ""
        dir = dir.slice(0, pos)
        limit = limit - 1
    return ""

# Re-parse the manifest TOML to get dep names as a Vec[str].
# This exists because Map has no key-iteration; we parse the raw file.
# -- tree -----------------------------------------------------------------------

# Print the resolved dependency graph as an indented tree.
def cmd_tree(manifest: Manifest, lockfile: Lockfile, project_root: str, verbose: bool) -> int:
    mut has_lock = lockfile.packages.len > 0
    mut res = resolve(manifest, project_root, lockfile, true, has_lock, false, verbose)
    if not res.ok:
        print("error: " + res.error)
        return 1
    print(manifest.name + " " + manifest.version)
    mut i = 0
    while i < res.root_deps.len:
        _print_tree_node(res, res.root_deps.get(i), "", i == res.root_deps.len - 1, 0)
        i = i + 1
    return 0

def _print_tree_node(res: Resolution, name: str, prefix: str, last: bool, depth: int):
    mut branch   = "|-- "
    mut childpfx = "|   "
    if last:
        branch   = "`-- "
        childpfx = "    "
    if not res.by_name.contains(name):
        print(prefix + branch + name + " (unresolved)")
        return
    mut d = res.by_name.get(name)
    print(prefix + branch + d.name + " " + d.version)
    if depth >= 40:
        return   # cycle guard
    mut i = 0
    while i < d.edges.len:
        _print_tree_node(res, d.edges.get(i), prefix + childpfx, i == d.edges.len - 1, depth + 1)
        i = i + 1


# -- audit ----------------------------------------------------------------------

# Verify every installed package's content against its locked checksum (tamper/drift check).
# A remote advisory-database check is a registry-v1 follow-up.
def cmd_audit(manifest: Manifest, lockfile: Lockfile, project_root: str, verbose: bool) -> int:
    if lockfile.packages.len == 0:
        print("No taupkg.lock found -- run `taupkg install` first.")
        return 0
    print("Auditing " + str(lockfile.packages.len) + " locked package(s)...")
    mut bad = 0
    mut i = 0
    while i < lockfile.packages.len:
        mut p = lockfile.packages.get(i)
        i = i + 1
        if p.checksum.len() == 0 or p.checksum == "none":
            continue
        mut dir = path_join(project_pkg_dir(project_root), p.name)
        if not File.dir_exists(dir):
            print("  ! " + p.name + "@" + p.version + " -- not installed")
            bad = bad + 1
            continue
        if hash_tree(dir) != p.checksum:
            print("  ! " + p.name + "@" + p.version + " -- checksum MISMATCH (tampered or modified)")
            bad = bad + 1
    if bad == 0:
        print("OK: integrity verified -- all installed packages match the lock.")
        return 0
    print("FAIL: " + str(bad) + " package(s) failed integrity verification.")
    return 1


# -- login ----------------------------------------------------------------------

# Store a registry API token in ~/.taupkg/credentials for `taupkg publish`.
def cmd_login(args: CliArgs) -> int:
    mut token = args.first_pos()
    if token.len() == 0:
        token = args.flag_val("token", "")
    if token.len() == 0:
        print("Usage: taupkg login <token>")
        print("Create a token in your registry account settings, then run `taupkg login <token>`.")
        return 1
    mkdir_p(taupkg_home())
    File.write_text(credentials_path(), "token = \"" + token + "\"\n")
    print("Saved credentials to " + credentials_path())
    return 0
