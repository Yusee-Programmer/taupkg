# Source URI parsing for taupkg.
#
# Supported source URI forms:
#   github:user/repo@v1.2.3      -> clone from GitHub at tag/branch
#   github:user/repo             -> clone latest default branch
#   git:https://host/repo@tag    -> arbitrary git URL
#   local:./relative/path        -> local directory (symlinked/copied)
#   local:/absolute/path         -> absolute local directory
#   registry:name@constraint     -> (default) look up in official registry
#
#   https://github.com/user/repo            -> plain GitHub repo URL (git clone)
#   https://github.com/user/repo.git        -> same, with explicit .git
#   https://github.com/user/repo/tree/<ref> -> GitHub repo URL pinned to a branch/tag
#   https://github.com/user/repo@<ref>      -> same, '@' form
#   https://.../archive/refs/tags/v1.zip    -> GitHub source archive (download + extract)
#   https://.../releases/download/v1/x.tar.gz -> GitHub release asset (download + extract)
#   archive:https://...                     -> explicit archive download (round-trip form)

pub class Source:
    pub kind: str      # "github" | "git" | "local" | "registry"
    pub uri: str       # raw URL or path
    pub ref: str       # tag / branch / commit; "" = default

extend Source:
    pub def init(kind: str, uri: str, ref: str) -> Source:
        mut s = Source()
        s.kind = kind
        s.uri  = uri
        s.ref  = ref
        return s

    pub def to_string(self) -> str:
        if self.kind == "archive":
            return "archive:" + self.uri
        if self.ref.len() > 0:
            return self.kind + ":" + self.uri + "@" + self.ref
        return self.kind + ":" + self.uri


# Parse a TOML inline table  `{ key = "val", key2 = "val2" }`  into a Map[str,str].
# Values keep their unquoted string form; keys are trimmed. Robust to whitespace
# and a trailing comma. (The dep-spec subset never contains commas inside values.)
def _parse_inline_table(raw: str) -> Map[str, str]:
    mut out = Map[str, str].init(8)
    mut inner = raw.trim()
    if inner.starts_with("{"): inner = inner.slice(1, inner.len())
    if inner.ends_with("}"):   inner = inner.slice(0, inner.len() - 1)
    for part in inner.split(","):
        mut kv = part.trim()
        if kv.len() == 0: continue
        mut eq = kv.index_of("=")
        if eq < 0: continue
        mut k = kv.slice(0, eq).trim()
        mut v = kv.slice(eq + 1, kv.len()).trim()
        if v.starts_with("\"") and v.ends_with("\"") and v.len() >= 2:
            v = v.slice(1, v.len() - 1)
        out.insert(k, v)
    return out

# Pull the git/github ref (tag > branch > rev) out of an inline dep table.
def _table_ref(tbl: Map[str, str]) -> str:
    if tbl.contains("tag"):    return tbl.get("tag")
    if tbl.contains("branch"): return tbl.get("branch")
    if tbl.contains("rev"):    return tbl.get("rev")
    return ""

# The version CONSTRAINT implied by a raw dep value. Inline tables with a
# `version` key carry a real constraint; path/git/github deps have none, so they
# unify against anything ("*"). A bare string value IS the constraint.
pub def dep_constraint(raw: str) -> str:
    mut s = raw.trim()
    if s.starts_with("{"):
        mut tbl = _parse_inline_table(s)
        if tbl.contains("version"): return tbl.get("version")
        return "*"
    # A source-based spec (local:/github:/git:/archive:/http) pins an exact checkout
    # — it provides one version and imposes NO semver range, so its constraint is "*".
    # (Returning the raw source string here made the resolver validate the resolved
    # version against e.g. "local:../..", which no version satisfies.) Only a BARE
    # version string ("^1.2", "~1.0", ">=1.3", "1.2.3", "*") is a real constraint.
    if s.starts_with("local:") or s.starts_with("github:") or s.starts_with("git:") or s.starts_with("archive:") or s.starts_with("http://") or s.starts_with("https://"):
        return "*"
    return s

# True if a dependency is declared optional (`{ ..., optional = true }`).
# Optional deps are only pulled in when a [features] entry enables them.
pub def dep_is_optional(raw: str) -> bool:
    mut s = raw.trim()
    if not s.starts_with("{"): return false
    mut tbl = _parse_inline_table(s)
    if tbl.contains("optional"): return tbl.get("optional") == "true"
    return false


# Parse a raw source string from taupkg.toml [sources] or [deps].
# Plain version constraints like "^1.2.0" are returned as registry sources.
# Inline tables `{ path = ... }` / `{ git = ... }` / `{ github = ... }` /
# `{ version = ... }` select the corresponding source kind (Cargo-style).
pub def parse_source(pkg_name: str, raw: str) -> Source:
    mut s = raw.trim()

    # Cargo-style inline-table dependency specification.
    if s.starts_with("{"):
        mut tbl = _parse_inline_table(s)
        if tbl.contains("path"):
            return Source.init("local", tbl.get("path"), "")
        if tbl.contains("git"):
            return Source.init("git", tbl.get("git"), _table_ref(tbl))
        if tbl.contains("github"):
            return Source.init("github", "https://github.com/" + tbl.get("github") + ".git", _table_ref(tbl))
        mut ver = "*"
        if tbl.contains("version"): ver = tbl.get("version")
        return Source.init("registry", pkg_name, ver)

    if s.starts_with("archive:"):
        return Source.init("archive", s.slice(8, s.len()), "")

    # Bare GitHub/HTTP URLs (not wrapped in github:/git: prefixes).
    if s.starts_with("https://") or s.starts_with("http://"):
        # GitHub source archives and release assets are downloaded and
        # extracted directly, not git-cloned.
        if s.contains("/releases/download/") or s.contains("/archive/") or s.ends_with(".tar.gz") or s.ends_with(".tgz") or s.ends_with(".zip"):
            return Source.init("archive", s, "")

        if s.contains("github.com/"):
            mut rest = s.slice(s.index_of("github.com/") + 11, s.len())
            mut ref = ""
            mut tree_pos = rest.index_of("/tree/")
            if tree_pos >= 0:
                ref  = rest.slice(tree_pos + 6, rest.len())
                rest = rest.slice(0, tree_pos)
            else:
                mut at_pos = rest.index_of("@")
                if at_pos >= 0:
                    ref  = rest.slice(at_pos + 1, rest.len())
                    rest = rest.slice(0, at_pos)
            while rest.len() > 0 and rest.ends_with("/"):
                rest = rest.slice(0, rest.len() - 1)
            if rest.ends_with(".git"):
                rest = rest.slice(0, rest.len() - 4)
            return Source.init("github", "https://github.com/" + rest + ".git", ref)

        # Arbitrary git-hosting URL (not GitHub).
        return Source.init("git", s, "")

    if s.starts_with("github:"):
        mut rest = s.slice(7, s.len())
        mut at_pos = rest.index_of("@")
        if at_pos >= 0:
            mut repo = rest.slice(0, at_pos)
            mut ref  = rest.slice(at_pos + 1, rest.len())
            mut url  = "https://github.com/" + repo + ".git"
            return Source.init("github", url, ref)
        else:
            mut url = "https://github.com/" + rest + ".git"
            return Source.init("github", url, "")

    if s.starts_with("git:"):
        mut rest = s.slice(4, s.len())
        mut at_pos = rest.index_of("@")
        if at_pos >= 0:
            mut url = rest.slice(0, at_pos)
            mut ref = rest.slice(at_pos + 1, rest.len())
            return Source.init("git", url, ref)
        return Source.init("git", rest, "")

    if s.starts_with("local:"):
        mut path = s.slice(6, s.len())
        return Source.init("local", path, "")

    # Default: treat the value as a version constraint -> registry lookup
    return Source.init("registry", pkg_name, s)


# Build the git clone command for a git/github source. The uri and dest are
# QUOTED so a path containing a space (e.g. C:\Users\First Last\...) doesn't split
# into extra args and make git dump its usage. Run via shell_run, which adds the
# Windows outer-quote wrapper so cmd /c preserves this interior quoting.
pub def source_clone_cmd(src: Source, dest_dir: str) -> str:
    mut u = "\"" + src.uri + "\""
    mut d = "\"" + dest_dir + "\""
    if src.ref.len() > 0:
        return "git clone --depth 1 --branch " + src.ref + " " + u + " " + d
    return "git clone --depth 1 " + u + " " + d
