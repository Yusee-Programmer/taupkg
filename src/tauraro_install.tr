# tauraro_install.tr
# Downloads and installs the Tauraro compiler from GitHub releases or tauraro.org.
#
# Zip layout (e.g. tauraroc-linux-arm64.zip):
#   tauraroc-linux-arm64/
#     tauraroc              <- compiler binary
#     runtime/
#       tauraro_rt.h        <- needed at every compilation
#     std/                  <- standard library .tr sources
#       io.tr, os.tr, ...
#
# The binary finds runtime/ and std/ relative to its own location, so
# the whole extracted folder must stay together -- we do NOT flatten it.
#
# Install destination: ~/.taupkg/bin/tauraroc-{os}-{arch}/
# PATH: that subfolder is added so `tauraroc` is directly on PATH.
#
# What we do NOT need from the repo:
#   src/       -- compiler source, only needed to rebuild tauraroc itself
#   examples/  -- not needed by end users
#
# GitHub URL:  https://github.com/tauraro/tauraro/releases/download/v{ver}/tauraroc-{os}-{arch}.zip
# Mirror URL:  https://tauraro.org/download/{ver}/tauraroc-{os}-{arch}.zip

from std.io import File
from std.os import OS, Process, Env
from util import path_join, mkdir_p, taupkg_home, shell_capture
from progress import download_with_progress, fmt_bytes, green, dim, cyan

# -- platform detection --------------------------------------------------------

pub def detect_os() -> str:
    if OS.is_windows():
        return "windows"
    mut s = shell_capture("uname -s")
    if s.contains("Darwin"):
        return "macos"
    return "linux"

pub def detect_arch() -> str:
    if OS.is_windows():
        mut a = Env.get_var("PROCESSOR_ARCHITECTURE")
        if a == "ARM64":
            return "arm64"
        return "x64"
    mut m = shell_capture("uname -m")
    if m == "aarch64" or m == "arm64":
        return "arm64"
    return "x64"

# -- version resolution --------------------------------------------------------

# The GitHub repo to install from. Override with TAURARO_REPO=owner/name.
pub def tauraro_repo() -> str:
    mut r = Env.get_var("TAURARO_REPO")
    if r.len() > 0:
        return r
    return "tauraro/tauraro"

# Extract the release version that follows `marker` in `text` (e.g. the newest
# `releases/tag/vX.Y.Z`), stopping at the first delimiter. Strips a leading "v".
def _version_after(text: str, marker: str) -> str:
    mut pos = text.index_of(marker)
    if pos < 0:
        return ""
    mut rest = text.slice(pos + marker.len(), text.len())
    mut i = 0
    # Skip a JSON `: "` (colon / spaces / opening quote) between marker and value.
    while i < rest.len() and (rest.char_at(i) == 32 or rest.char_at(i) == 9 or rest.char_at(i) == 58 or rest.char_at(i) == 34):
        i = i + 1
    mut tag = ""
    while i < rest.len():
        mut c = rest.char_at(i)
        # stop at: / " < > space, tab, CR, LF, ? & — anything not part of a tag
        if c == 47 or c == 34 or c == 60 or c == 62 or c == 32 or c == 9 or c == 13 or c == 10 or c == 63 or c == 38:
            i = rest.len()
        else:
            tag = tag + rest.slice(i, i + 1)
            i = i + 1
    if tag.starts_with("v"):
        return tag.slice(1, tag.len())
    return tag

# Resolve the latest release version WITHOUT the GitHub API (which rate-limits /
# 403s unauthenticated). Primary: the releases Atom feed on github.com (newest
# first, includes prereleases). Fallbacks: the /releases/latest redirect, then the
# API. Returns the version without a leading "v", or "" on total failure.
pub def fetch_latest_version() -> str:
    mut repo = tauraro_repo()
    # A) Atom feed — github.com, no rate limit.
    mut atom = shell_capture("curl -fsSL -A taupkg \"https://github.com/" + repo + "/releases.atom\"")
    mut v = _version_after(atom, "releases/tag/")
    if v.len() > 0:
        return v
    # B) Follow the /releases/latest HTML redirect to /releases/tag/<v>.
    mut hdrs = shell_capture("curl -sIL -A taupkg \"https://github.com/" + repo + "/releases/latest\"")
    v = _version_after(hdrs, "releases/tag/")
    if v.len() > 0:
        return v
    # C) Last resort: the GitHub API (may 403 when rate-limited).
    mut json = shell_capture("curl -fsSL -A taupkg \"https://api.github.com/repos/" + repo + "/releases/latest\"")
    return _version_after(json, "\"tag_name\":")

# -- download ------------------------------------------------------------------

# curl ships on Windows 10+, macOS, and all major Linux distros.
# -f = fail on HTTP error  -S = show errors  -L = follow redirects
pub def curl_download(url: str, dest: str, verbose: bool) -> int:
    mut silence = "-s "
    if verbose: silence = ""
    mut cmd = "curl " + silence + "-fSL -o \"" + dest + "\" \"" + url + "\""
    return Process.system(cmd)

# -- extraction ----------------------------------------------------------------

# Extract zip into dest_dir, preserving the top-level folder inside the zip.
# After this, dest_dir/tauraroc-{os}-{arch}/ contains the binary + runtime/ + std/.
pub def extract_zip(zip_path: str, dest_dir: str, os_name: str) -> int:
    if os_name == "windows":
        # PowerShell Expand-Archive works reliably with Windows paths (including spaces
        # and drive letters that confuse Git-Bash tar). Silence its built-in progress
        # widget so only taupkg's own UI shows.
        mut cmd = "powershell -Command \"$ProgressPreference='SilentlyContinue'; Expand-Archive -Force -Path '" + zip_path + "' -DestinationPath '" + dest_dir + "'\""
        mut rc = Process.system(cmd)
        if rc != 0:
            # Fallback: unzip via Git Bash (available on most Windows dev machines)
            cmd = "unzip -oq \"" + zip_path + "\" -d \"" + dest_dir + "\""
            rc = Process.system(cmd)
        return rc
    else:
        # unzip preserves the top-level directory from the zip
        mut cmd = "unzip -oq \"" + zip_path + "\" -d \"" + dest_dir + "\""
        mut rc = Process.system(cmd)
        if rc != 0:
            # Fallback: Python (available on almost every system)
            cmd = "python3 -c \"import zipfile,sys; zipfile.ZipFile(sys.argv[1]).extractall(sys.argv[2])\" \"" + zip_path + "\" \"" + dest_dir + "\""
            rc = Process.system(cmd)
        return rc

# -- PATH setup ----------------------------------------------------------------

# Windows: setx writes to the user's persistent PATH registry key.
# The current session won't see it, but every new terminal will.
pub def setup_path_windows(install_dir: str):
    # Read current user PATH from registry to avoid clobbering it
    mut cur = shell_capture("powershell -Command \"[Environment]::GetEnvironmentVariable('PATH','User')\"")
    if cur.contains(install_dir):
        print("  PATH already contains " + install_dir)
        return
    mut new_path = cur + ";" + install_dir
    mut cmd = "powershell -Command \"[Environment]::SetEnvironmentVariable('PATH','" + new_path + "','User')\""
    mut rc = Process.system(cmd)
    if rc == 0:
        print("  Added to user PATH. Open a new terminal to use tauraroc.")
    else:
        print("  Could not update PATH automatically.")
        print("  Add this directory to your PATH manually:")
        print("    " + install_dir)

# Unix: append export line to shell profiles that exist, skip if already present.
pub def setup_path_unix(install_dir: str):
    mut export_line = "export PATH=\"" + install_dir + ":$PATH\""
    mut marker = "# added by taupkg install-tauraro"

    mut home = Env.get_var("HOME")
    mut profiles = Vec[str].init(4)
    profiles.push(path_join(home, ".profile"))
    profiles.push(path_join(home, ".bashrc"))
    profiles.push(path_join(home, ".zshrc"))

    mut added = false
    mut i = 0
    while i < profiles.len:
        mut p = profiles.get(i)
        if File.file_exists(p):
            mut content = File.read_text(p)
            if not content.contains(install_dir):
                File.write_text(p, content + "\n" + marker + "\n" + export_line + "\n")
                print("  Updated " + p)
                added = true
        i = i + 1

    if not added:
        print("  Add this line to your shell profile (~/.bashrc, ~/.zshrc, etc.):")
        print("    " + export_line)
    else:
        print("  Restart your terminal or run:  source ~/.profile")

# -- main entry ----------------------------------------------------------------

pub def install_tauraro(version: str, use_mirror: bool, verbose: bool) -> int:
    mut os_name = detect_os()
    mut arch    = detect_arch()

    mut ver = version.trim()
    if ver.starts_with("v"):
        ver = ver.slice(1, ver.len())

    if ver.len() == 0:
        print("Fetching latest version...")
        ver = fetch_latest_version()
        if ver.len() == 0:
            print("error: could not determine latest version.")
            print("       Pass --version x.y.z or check your internet connection.")
            return 1

    print("Installing tauraroc " + ver + " (" + os_name + "-" + arch + ")...")

    # e.g. "tauraroc-linux-arm64"
    mut pkg_stem = "tauraroc-" + os_name + "-" + arch
    mut zip_name = pkg_stem + ".zip"
    mut tag      = "v" + ver

    mut url = ""
    if use_mirror:
        url = "https://tauraro.org/download/" + ver + "/" + zip_name
    else:
        url = "https://github.com/" + tauraro_repo() + "/releases/download/" + tag + "/" + zip_name

    # ~/.taupkg/bin/ holds one subfolder per installed tauraroc version/platform
    mut bin_root = path_join(taupkg_home(), "bin")
    mut zip_path = path_join(taupkg_home(), zip_name)
    # The final install dir is the folder the zip extracts to
    mut install_dir = path_join(bin_root, pkg_stem)
    mkdir_p(bin_root)

    # Remove stale install for this platform if present
    if File.dir_exists(install_dir):
        if os_name == "windows":
            Process.system("rmdir /s /q \"" + install_dir + "\" 2>nul")
        else:
            Process.system("rm -rf \"" + install_dir + "\"")

    # Download with a live progress bar (percentage / size / speed / ETA).
    mut rc = download_with_progress(url, zip_path, "tauraroc " + ver)
    if rc != 0:
        if not use_mirror:
            print("  GitHub download failed, trying tauraro.org mirror...")
            mut mirror_url = "https://tauraro.org/download/" + ver + "/" + zip_name
            rc = download_with_progress(mirror_url, zip_path, "tauraroc " + ver + " (mirror)")
        if rc != 0:
            print("error: download failed for " + zip_name)
            print("       Check that version " + ver + " exists for " + os_name + "-" + arch + ".")
            return 1

    # Extract -- zip contains tauraroc-{os}-{arch}/ as top-level folder
    print("  " + dim("extracting…"))
    mut ex_rc = extract_zip(zip_path, bin_root, os_name)
    if ex_rc != 0:
        print("error: extraction failed.")
        if os_name != "windows":
            print("       Make sure 'unzip' is installed (apt install unzip / brew install unzip).")
        return 1

    # Remove zip file
    if os_name == "windows":
        Process.system("del /f /q \"" + zip_path + "\" 2>nul")
    else:
        Process.system("rm -f \"" + zip_path + "\"")

    # Locate the binary inside the extracted tree.
    # New zips have layout: tauraroc-{platform}/tauraroc[.exe]
    # Legacy zips (full-repo) have the binary at the root of bin_root.
    mut bin_name = "tauraroc"
    if os_name == "windows":
        bin_name = "tauraroc.exe"

    # Preferred: structured subfolder
    mut bin_path = path_join(install_dir, bin_name)
    if not File.file_exists(bin_path):
        # Fallback: flat zip extracted directly into bin_root
        mut flat_bin = path_join(bin_root, bin_name)
        if File.file_exists(flat_bin):
            # Move it into the expected subfolder so PATH points correctly
            mkdir_p(install_dir)
            if os_name == "windows":
                Process.system("move /y \"" + flat_bin + "\" \"" + install_dir + "\" 2>nul")
            else:
                Process.system("mv \"" + flat_bin + "\" \"" + install_dir + "/\"")
            # Also move runtime/ and std/ if present at bin_root level
            mut rt_src = path_join(bin_root, "runtime")
            mut std_src = path_join(bin_root, "std")
            if File.dir_exists(rt_src):
                if os_name == "windows":
                    Process.system("move /y \"" + rt_src + "\" \"" + install_dir + "\" 2>nul")
                else:
                    Process.system("mv \"" + rt_src + "\" \"" + install_dir + "/\"")
            if File.dir_exists(std_src):
                if os_name == "windows":
                    Process.system("move /y \"" + std_src + "\" \"" + install_dir + "\" 2>nul")
                else:
                    Process.system("mv \"" + std_src + "\" \"" + install_dir + "/\"")
        else:
            print("error: could not find tauraroc binary after extraction.")
            print("       Expected: " + bin_path)
            return 1

    # Ensure executable on Unix
    if os_name != "windows":
        Process.system("chmod +x \"" + bin_path + "\"")

    # Quick smoke-test — run via shell with proper quoting
    mut check = ""
    if os_name == "windows":
        check = shell_capture("\"" + bin_path + "\" --version")
    else:
        check = shell_capture("\"" + bin_path + "\" --version 2>/dev/null")
    if check.len() > 0:
        print("  OK: " + check)
    elif verbose:
        print("  (could not verify binary -- it may still work)")

    print("")
    print("Installed:")
    print("  binary:  " + bin_path)
    print("  runtime: " + path_join(install_dir, "runtime/tauraro_rt.h"))
    print("  std:     " + path_join(install_dir, "std/"))
    print("")

    # Add install_dir to PATH so `tauraroc` is found directly
    if os_name == "windows":
        setup_path_windows(install_dir)
    else:
        setup_path_unix(install_dir)

    return 0
