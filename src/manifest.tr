# Manifest -- reads and represents a taupkg.toml file.

from std.io import File
from toml import toml_load, TomlDoc, TomlSection

class Manifest:
    pub name: str
    pub version: str
    pub desc: str
    pub license: str
    pub bin: str
    pub authors: Vec[str]
    pub deps: Map[str, str]
    pub build_deps: Map[str, str]
    pub sources: Map[str, str]

extend Manifest:
    pub def init() -> Manifest:
        mut m = Manifest()
        m.name = ""
        m.version = ""
        m.desc = ""
        m.license = "MIT"
        m.bin = ""
        m.authors = Vec[str].init(4)
        m.deps = Map[str, str].init(8)
        m.build_deps = Map[str, str].init(4)
        m.sources = Map[str, str].init(4)
        return m

    pub def is_valid(self) -> bool:
        return self.name.len() > 0 and self.version.len() > 0

    pub def load(path: str) -> Manifest:
        mut m = Manifest.init()
        mut doc = toml_load(path)
        mut pkg = doc.get_section("package")

        if pkg.keys.contains("name"):    m.name    = pkg.keys.get("name")
        if pkg.keys.contains("version"): m.version = pkg.keys.get("version")
        if pkg.keys.contains("desc"):    m.desc    = pkg.keys.get("desc")
        if pkg.keys.contains("bin"):     m.bin     = pkg.keys.get("bin")
        if pkg.keys.contains("license"):
            m.license = pkg.keys.get("license")
        if pkg.keys.contains("authors"):
            m.authors.push(pkg.keys.get("authors"))

        mut deps_sec   = doc.get_section("deps")
        mut bdeps_sec  = doc.get_section("build-deps")
        mut src_sec    = doc.get_section("sources")
        m.deps         = deps_sec.keys
        m.build_deps   = bdeps_sec.keys
        m.sources      = src_sec.keys

        return m


def find_manifest(start_dir: str) -> str:
    mut dir = start_dir
    mut limit = 16
    while limit > 0:
        mut candidate = dir + "/taupkg.toml"
        if File.file_exists(candidate):
            return candidate
        mut pos = dir.len() - 1
        while pos > 0:
            mut c = dir.char_at(pos)
            if c == 47 or c == 92:
                break
            pos = pos - 1
        if pos <= 0:
            return ""
        dir = dir.slice(0, pos)
        limit = limit - 1
    return ""
