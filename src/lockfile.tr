# Lock file — taupkg.lock
#
# Format (custom, line-oriented):
#   # taupkg lock file — do not edit manually
#   [pkg]
#   name    = "pkgname"
#   version = "1.2.3"
#   source  = "github:user/repo@v1.2.3"
#   checksum = "sha256:abcdef..."
#
# One [pkg] block per resolved dependency (including transitive deps).

from std.io import File
from toml import toml_load, TomlDoc

class LockedPkg:
    pub name: str
    pub version: str
    pub source: str
    pub checksum: str

extend LockedPkg:
    pub def init(name: str, version: str, source: str, checksum: str) -> LockedPkg:
        mut p = LockedPkg()
        p.name     = name
        p.version  = version
        p.source   = source
        p.checksum = checksum
        return p


class LockFile:
    pub packages: Vec[LockedPkg]

extend LockFile:
    pub def init() -> LockFile:
        mut lf = LockFile()
        lf.packages = Vec[LockedPkg].init(8)
        return lf

    pub def find(self, name: str) -> LockedPkg:
        mut i = 0
        while i < self.packages.len:
            mut p = self.packages.get(i)
            if p.name == name:
                return p
            i = i + 1
        return LockedPkg.init("", "", "", "")

    pub def has(self, name: str) -> bool:
        return self.find(name).name.len() > 0

    pub def upsert(mut self, pkg: LockedPkg):
        mut i = 0
        while i < self.packages.len:
            mut p = self.packages.get(i)
            if p.name == pkg.name:
                self.packages.set(i, pkg)
                return
            i = i + 1
        self.packages.push(pkg)

    # Serialize to taupkg.lock content string.
    pub def to_string(self) -> str:
        mut out = "# taupkg lock file — do not edit manually\n\n"
        mut i = 0
        while i < self.packages.len:
            mut p = self.packages.get(i)
            out = out + "[pkg]\n"
            out = out + "name     = \"" + p.name     + "\"\n"
            out = out + "version  = \"" + p.version  + "\"\n"
            out = out + "source   = \"" + p.source   + "\"\n"
            out = out + "checksum = \"" + p.checksum + "\"\n"
            out = out + "\n"
            i = i + 1
        return out

    # Write taupkg.lock to the given path.
    pub def save(self, path: str):
        File.write_text(path, self.to_string())

    # Load taupkg.lock from the given path.
    pub def load(path: str) -> LockFile:
        mut lf = LockFile.init()
        if not File.file_exists(path):
            return lf
        mut doc = toml_load(path)
        mut pkgs = doc.get_array("pkg")
        mut i = 0
        while i < pkgs.len:
            mut sec = pkgs.get(i)
            mut name     = sec.keys.get("name")     if sec.keys.contains("name")     else ""
            mut version  = sec.keys.get("version")  if sec.keys.contains("version")  else ""
            mut source   = sec.keys.get("source")   if sec.keys.contains("source")   else ""
            mut checksum = sec.keys.get("checksum") if sec.keys.contains("checksum") else ""
            if name.len() > 0:
                lf.packages.push(LockedPkg.init(name, version, source, checksum))
            i = i + 1
        return lf
