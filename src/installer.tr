# Installer -- fetch and install packages into .taupkg/packages/<name>/.
#
# Install flow:
#   1. Parse source URI to get kind/url/ref
#   2. For git/github: git clone into .taupkg/packages/<name>/
#   3. For local: copy the directory into .taupkg/packages/<name>/
#   4. For registry: fetch version list, pick best, then treat as git source
#   5. Compute checksum of installed taupkg.toml (stable identity)
#   6. Return LockedPkg for the lockfile

from std.io import File
from std.os import OS, Process
from util import path_join, mkdir_p, rm_rf, rm_f, cp_r, flatten_single_subdir, shell_capture, shell_run, project_pkg_dir, hash_tree, path_resolve
from source import Source, parse_source, source_clone_cmd
from manifest import Manifest
from lockfile import LockedPkg
from semver import Version
from crypto.hash import Hash

# Install a single package into the project's packages directory.
# Returns a LockedPkg describing what was installed, or an empty LockedPkg on failure.
pub def install_package(
    pkg_name: str,
    constraint: str,
    source_uri: str,
    project_root: str,
    verbose: bool
) -> LockedPkg:
    mut src = parse_source(pkg_name, source_uri)
    mut pkg_dir = path_join(project_pkg_dir(project_root), pkg_name)

    # Remove stale install if present
    if File.dir_exists(pkg_dir):
        rm_rf(pkg_dir)

    mkdir_p(project_pkg_dir(project_root))

    mut installed_version = ""
    mut installed_source  = src.to_string()

    if src.kind == "local":
        # Anchor a relative local path to project_root (absolute paths pass
        # through). The resolver already rebases transitive deps to absolute; this
        # also handles project-root-relative sources replayed from the lock.
        mut local_path = path_resolve(project_root, src.uri)
        if verbose:
            print("  [local] Copying " + local_path + " -> " + pkg_dir)
        mut ok = cp_r(local_path, pkg_dir)
        if not ok:
            print("error: failed to copy local package " + pkg_name + " from " + local_path)
            return LockedPkg.init("", "", "", "")
        mut mf = Manifest.load(path_join(pkg_dir, "taupkg.toml"))
        installed_version = mf.version
        installed_source  = "local:" + local_path

    elif src.kind == "github" or src.kind == "git":
        mut cmd = source_clone_cmd(src, pkg_dir)
        if verbose:
            print("  [git] " + cmd)
        mut rc = shell_run(cmd)
        if rc != 0:
            print("error: git clone failed for " + pkg_name)
            return LockedPkg.init("", "", "", "")
        mut mf = Manifest.load(path_join(pkg_dir, "taupkg.toml"))
        installed_version = mf.version
        if installed_version.len() == 0:
            installed_version = src.ref
        # Pin the exact commit SHA in the recorded source, so the lock replays byte-for-byte even
        # if the upstream tag/branch later moves (reproducibility + tamper-evidence).
        mut sha = shell_capture("git -C \"" + pkg_dir + "\" rev-parse HEAD")
        if sha.len() >= 7:
            installed_source = src.kind + ":" + src.uri + "@" + sha

    elif src.kind == "archive":
        mkdir_p(pkg_dir)
        mut tmp_file = path_join(project_pkg_dir(project_root), "_" + pkg_name + "_download")
        if src.uri.ends_with(".zip"):
            tmp_file = tmp_file + ".zip"
        elif src.uri.ends_with(".tgz"):
            tmp_file = tmp_file + ".tgz"
        else:
            tmp_file = tmp_file + ".tar.gz"
        if verbose:
            print("  [archive] downloading " + src.uri)
        mut dl_cmd = "curl -fsSL -o \"" + tmp_file + "\" \"" + src.uri + "\""
        mut rc = Process.system(dl_cmd)
        if rc != 0:
            print("error: failed to download " + src.uri)
            return LockedPkg.init("", "", "", "")
        if verbose:
            print("  [archive] extracting -> " + pkg_dir)
        mut ex_cmd = "tar -xf \"" + tmp_file + "\" -C \"" + pkg_dir + "\""
        rc = Process.system(ex_cmd)
        rm_f(tmp_file)
        if rc != 0:
            print("error: failed to extract " + src.uri)
            return LockedPkg.init("", "", "", "")
        flatten_single_subdir(pkg_dir)
        mut mf = Manifest.load(path_join(pkg_dir, "taupkg.toml"))
        installed_version = mf.version
        if installed_version.len() == 0:
            installed_version = src.ref

    elif src.kind == "registry":
        # Registry install: ask registry for available versions, pick best, then clone
        mut reg_result = registry_resolve(pkg_name, constraint)
        if reg_result.version.len() == 0:
            print("error: no version of " + pkg_name + " satisfies " + constraint)
            return LockedPkg.init("", "", "", "")
        if verbose:
            print("  [registry] " + pkg_name + "@" + reg_result.version + " -> " + reg_result.clone_url)
        mut git_src = Source.init("git", reg_result.clone_url, reg_result.tag)
        mut cmd = source_clone_cmd(git_src, pkg_dir)
        mut rc = shell_run(cmd)
        if rc != 0:
            print("error: failed to fetch " + pkg_name + " from registry")
            return LockedPkg.init("", "", "", "")
        installed_version = reg_result.version
        installed_source  = git_src.to_string()

    else:
        print("error: unknown source kind '" + src.kind + "' for " + pkg_name)
        return LockedPkg.init("", "", "", "")

    # Integrity: a full-content hash of the ENTIRE installed tree (every source file), not just the
    # manifest — so any tampering or drift is detectable on the next build/verify.
    mut checksum = hash_tree(pkg_dir)

    mut result = LockedPkg.init(pkg_name, installed_version, installed_source, checksum)
    result.constraint = constraint
    return result


# Replay an EXACT locked package (used by `taupkg install --locked`). Installs from the pinned source,
# then re-hashes the tree and refuses to proceed if it doesn't match the lock (tamper/drift guard).
# Returns an empty LockedPkg on any failure.
pub def install_from_lock(lp: LockedPkg, project_root: str, offline: bool, verbose: bool) -> LockedPkg:
    mut pkg_dir = path_join(project_pkg_dir(project_root), lp.name)
    # If already present and matches, reuse it (offline-friendly, no network).
    if File.dir_exists(pkg_dir):
        if hash_tree(pkg_dir) == lp.checksum:
            if verbose:
                print("  " + lp.name + "@" + lp.version + " (locked, verified)")
            return lp
        rm_rf(pkg_dir)
    if offline:
        print("error: --offline: " + lp.name + " is not present in .taupkg/packages/ and cannot be fetched")
        return LockedPkg.init("", "", "", "")
    mut fetched = install_package(lp.name, lp.constraint, lp.source, project_root, verbose)
    if fetched.name.len() == 0:
        return LockedPkg.init("", "", "", "")
    if lp.checksum != "none" and fetched.checksum != lp.checksum:
        print("error: checksum mismatch for " + lp.name + " — locked " + lp.checksum + " but got " + fetched.checksum)
        print("       the upstream source changed. Run `taupkg update " + lp.name + "` to accept the new content.")
        rm_rf(pkg_dir)
        return LockedPkg.init("", "", "", "")
    return lp


# Result returned by registry_resolve.
pub class RegistryResult:
    pub version: str
    pub clone_url: str
    pub tag: str

extend RegistryResult:
    pub def init(v: str, url: str, tag: str) -> RegistryResult:
        mut r = RegistryResult()
        r.version   = v
        r.clone_url = url
        r.tag       = tag
        return r


# Ask the official taupkg registry for the best matching version.
# Returns empty RegistryResult if resolution fails.
pub def registry_resolve(pkg_name: str, constraint: str) -> RegistryResult:
    from registry import registry_fetch_versions, registry_clone_url
    mut versions = registry_fetch_versions(pkg_name)
    if versions.len == 0:
        return RegistryResult.init("", "", "")
    mut best = Version.best_match(versions, constraint)
    if best.len() == 0:
        return RegistryResult.init("", "", "")
    mut url = registry_clone_url(pkg_name)
    mut tag = "v" + best
    if not tag.starts_with("v"):
        tag = best
    return RegistryResult.init(best, url, tag)
